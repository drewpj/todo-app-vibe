# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically.

# Secret used to sign login tokens. Use 32+ random characters, e.g.:  openssl rand -base64 48
# If unset, docker-compose.yml falls back to an INSECURE local-only default.
JWT_SIGNING_KEY=

# Host port for the web UI.
WEB_PORT=8080
